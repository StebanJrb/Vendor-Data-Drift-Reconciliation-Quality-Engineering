# Copy to .env and fill in real values. .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Pipeline run — what src/main.py needs to know for a single execution.
# Set by whatever invokes this image (locally, that's you; in real use,
# the external orchestration-hub repo passes this in per scheduled run).
# ---------------------------------------------------------------------------
YEAR_MONTH=2023-07

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage) — where synthetic vendor drops land,
# under raw/vendor-drops/YYYY-MM/
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET_NAME=vendor-drops

# boto3 in src/ingestion/ authenticates with these. Values must match the
# MinIO credentials above — when running inside docker-compose, the endpoint
# becomes http://minio:9000 instead of localhost (see docker-compose.yml).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_change_me
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# PostgreSQL — one instance, two logical databases:
#   warehouse -> trusted + quarantine tables
#   mlflow    -> MLflow backend store
# (created automatically by docker/postgres/init-multiple-dbs.sh on first boot)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

WAREHOUSE_DB=warehouse
MLFLOW_DB=mlflow

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts
